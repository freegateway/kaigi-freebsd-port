#!/bin/sh

# PROVIDE: kaigi
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown

kaigi_locked=NO
if [ "${1:-}" = --locked ]; then
	kaigi_locked=YES
	shift
fi

. /etc/rc.subr

name="kaigi"
rcvar="kaigi_enable"
load_rc_config "$name"

: ${kaigi_enable:="NO"}
: ${kaigi_instances:=""}
: ${kaigi_daemon_user:="www"}
: ${kaigi_daemon_group:="www"}
: ${kaigi_start_timeout:="30"}
: ${NODE_ENV:="production"}
export NODE_ENV

kaigi_action="${1:-}"
kaigi_operation="${kaigi_action}"
case "${kaigi_operation}" in
	one*) kaigi_operation="${kaigi_operation#one}" ;;
	force*) kaigi_operation="${kaigi_operation#force}" ;;
	fast*) kaigi_operation="${kaigi_operation#fast}" ;;
	quiet*) kaigi_operation="${kaigi_operation#quiet}" ;;
esac
if [ "$#" -gt 2 ]; then
	echo "Usage: $0 action [instance]"
	exit 1
fi

# Validate the entire list before operating. Never expand malformed globs.
set -f
kaigi_shutdown=NO
case "${kaigi_operation}" in stop|status) kaigi_shutdown=YES ;; esac
if [ "${kaigi_shutdown}" = YES ]; then
	# An explicit stop/status remains available after removal from rc.conf.
	if [ -n "${2:-}" ]; then
		kaigi_instances="$2"
	else
		# Include running instances even after the configured list changes.
		set +f
		kaigi_running=""
		for kaigi_file in /var/run/kaigi/*/kaigi.pid; do
			[ -f "${kaigi_file}" ] || continue
			kaigi_dir="${kaigi_file%/kaigi.pid}"
			kaigi_running="${kaigi_running} ${kaigi_dir##*/}"
		done
		set -f
		kaigi_valid=""
		for kaigi_instance in ${kaigi_instances} ${kaigi_running}; do
			case "${kaigi_instance}" in *[!a-z0-9_]*|[!a-z]*) continue ;; esac
			[ "${#kaigi_instance}" -le 32 ] || continue
			case " ${kaigi_valid} " in *" ${kaigi_instance} "*) continue ;; esac
			kaigi_valid="${kaigi_valid} ${kaigi_instance}"
		done
		kaigi_instances="${kaigi_valid}"
	fi
fi
kaigi_seen=" "
for kaigi_instance in ${kaigi_instances}; do
	case "${kaigi_instance}" in
		[a-z]*) ;;
		*) echo "kaigi: instance names must begin with a lowercase letter"; exit 1 ;;
	esac
	case "${kaigi_instance}" in
		*[!a-z0-9_]*) echo "kaigi: invalid instance name: ${kaigi_instance}"; exit 1 ;;
	esac
	if [ "${#kaigi_instance}" -gt 32 ]; then
		echo "kaigi: instance names must not exceed 32 characters"
		exit 1
	fi
	case "${kaigi_seen}" in
		*" ${kaigi_instance} "*) echo "kaigi: duplicate instance: ${kaigi_instance}"; exit 1 ;;
	esac
	kaigi_seen="${kaigi_seen}${kaigi_instance} "
done

# Size automatic worker pools against all configured instances, including when
# starting or restarting only one selected instance.
KAIGI_INSTANCE_COUNT=0
for kaigi_instance in ${kaigi_instances}; do
    KAIGI_INSTANCE_COUNT=$((KAIGI_INSTANCE_COUNT + 1))
done
export KAIGI_INSTANCE_COUNT

kaigi_selected="${kaigi_instances}"
if [ -n "${2:-}" ]; then
	case "$2" in
		*[!a-z0-9_]*) echo "kaigi: invalid requested instance"; exit 1 ;;
	esac
	case "${kaigi_seen}" in
		*" $2 "*) kaigi_selected="$2" ;;
		*) echo "kaigi: instance is not configured: $2"; exit 1 ;;
	esac
fi
set +f
case "${kaigi_operation}" in
	start|restart)
		if [ -z "${kaigi_seen# }" ]; then
			echo 'kaigi: set kaigi_instances to at least one explicit instance name'
			exit 1
		fi
		;;
esac

kaigi_directory()
{
	if [ -L "$1" ]; then
		echo "${name}: directory must not be a symlink: $1"
		return 1
	fi
	install -d -m "$2" -o "$3" -g "$4" "$1"
}

kaigi_precmd()
{
	# fast/force must not bypass instance identity or replace a live snapshot.
	if [ -n "$(check_pidfile "${pidfile}" "%%LOCALBASE%%/bin/node")" ]; then
		echo "${name}: already running; use restart"
		return 1
	fi
	# Root controls PID directories; service accounts cannot replace PID files.
	kaigi_directory /var/run/kaigi 0755 root wheel || return 1
	kaigi_directory /var/log/kaigi 0755 root wheel || return 1
	kaigi_directory "${kaigi_run_dir}" 0755 root wheel || return 1
	kaigi_session_reset || return 1
	kaigi_directory "${kaigi_log_dir}" 0755 root wheel || return 1
	"%%LOCALBASE%%/bin/node" "%%WWWDIR%%/app/src/StartupSafety.js" save-plan /var/run/kaigi/preflight.json "${KAIGI_INSTANCE}" "${kaigi_run_dir}/launch-plan.json" || return 1
	kaigi_directory /var/db/kaigi 0755 root wheel || return 1
	kaigi_directory "${KAIGI_STATE_DIR}" 0700 "${kaigi_run_user}" "${kaigi_run_group}" || return 1

	for kaigi_file in kaigi.conf users; do
		if [ ! -f "${KAIGI_CONFIG_DIR}/${kaigi_file}" ] || [ ! -r "${KAIGI_CONFIG_DIR}/${kaigi_file}" ]; then
			echo "${name}: missing or unreadable file: ${KAIGI_CONFIG_DIR}/${kaigi_file}"
			return 1
		fi
	done
	kaigi_secret_file="${KAIGI_CONFIG_DIR}/jwt-secret"
	if [ -L "${kaigi_secret_file}" ]; then
		echo "${name}: jwt-secret must not be a symlink"
		return 1
	fi
	if [ ! -e "${kaigi_secret_file}" ]; then
		kaigi_secret=$(/usr/bin/openssl rand -hex 32) || return 1
		(umask 077; set -C; printf '%s\n' "${kaigi_secret}" > "${kaigi_secret_file}") || return 1
		unset kaigi_secret
	fi
	if [ ! -f "${kaigi_secret_file}" ]; then
		echo "${name}: jwt-secret must be a regular file"
		return 1
	fi
	JWT_SECRET="$(cat "${kaigi_secret_file}")" || return 1
	if [ "${#JWT_SECRET}" -lt 32 ]; then
		echo "${name}: JWT secret must contain at least 32 characters"
		return 1
	fi
	HOST_USERS="$(cat "${KAIGI_CONFIG_DIR}/users")" || return 1
	export JWT_SECRET HOST_USERS
	kaigi_ready_dir=$(mktemp -d "${kaigi_session_dir}/startup.XXXXXX") || return 1
	trap 'kaigi_ready_cleanup' 0
	trap 'exit 1' HUP INT TERM
	chown "${kaigi_run_user}:${kaigi_run_group}" "${kaigi_ready_dir}" || return 1
	KAIGI_READY_FILE="${kaigi_ready_dir}/ready.json"
	KAIGI_STARTUP_NONCE=$(/usr/bin/openssl rand -hex 16) || return 1
	KAIGI_SERVICE=1
	export KAIGI_READY_FILE KAIGI_STARTUP_NONCE KAIGI_SERVICE

	for kaigi_file in "${pidfile}" "${kaigi_supervisor_pidfile}" "${kaigi_log_dir}/kaigi.log"; do
		if [ -L "${kaigi_file}" ]; then
			echo "${name}: runtime file must not be a symlink: ${kaigi_file}"
			return 1
		fi
	done
	# Rotation signals this instance's supervisor, not Node or syslogd.
	kaigi_directory /var/run/kaigi/newsyslog 0755 root wheel || return 1
	kaigi_rotation="/var/run/kaigi/newsyslog/${KAIGI_INSTANCE}.conf"
	if [ -L "${kaigi_rotation}" ]; then
		echo "${name}: rotation entry must not be a symlink"
		return 1
	fi
	(umask 022; printf '%s\t640\t7\t1000\t*\tJC\t%s\n' "${kaigi_log_dir}/kaigi.log" "${kaigi_supervisor_pidfile}" > "${kaigi_rotation}") || return 1
	cd "%%WWWDIR%%" || return 1
}

kaigi_stopped()
{
	# Refuse cleanup even for an unexpected live process in either PID file.
	for kaigi_check_file in "${pidfile}" "${kaigi_supervisor_pidfile}"; do
		[ ! -L "${kaigi_check_file}" ] || return 1
		[ -e "${kaigi_check_file}" ] || continue
		kaigi_check_pid=$(cat "${kaigi_check_file}") || return 1
		case "${kaigi_check_pid}" in ''|*[!0-9]*) return 1 ;; esac
		[ "${kaigi_check_pid}" -gt 1 ] || return 1
		if kill -0 "${kaigi_check_pid}" 2>/dev/null; then
			echo "${name}: process ${kaigi_check_pid} remains alive; preserving session directory"
			return 1
		fi
	done
}

kaigi_session_remove()
{
	kaigi_stopped || return 1
	[ "${kaigi_session_dir}" = "/var/run/kaigi/${KAIGI_INSTANCE}/session" ] || return 1
	if [ -L "${kaigi_session_dir}" ]; then
		echo "${name}: session directory must not be a symlink"
		return 1
	fi
	[ ! -e "${kaigi_session_dir}" ] || [ -d "${kaigi_session_dir}" ] || return 1
	# The exact target is below the validated root-controlled instance directory.
	rm -rf -- "${kaigi_session_dir}"
}

kaigi_session_reset()
{
	kaigi_session_remove || return 1
	# Retire readiness directories from releases predating session/. Never
	# follow a link or touch an administrator's custom socket outside session/.
	for kaigi_old_ready in "${kaigi_run_dir}"/startup.??????; do
		[ ! -L "${kaigi_old_ready}" ] || continue
		[ -d "${kaigi_old_ready}" ] || continue
		rm -rf -- "${kaigi_old_ready}" || return 1
	done
	kaigi_directory "${kaigi_session_dir}" 0750 "${kaigi_run_user}" "${kaigi_run_group}"
}

kaigi_ready_cleanup()
{
	[ -n "${kaigi_ready_dir:-}" ] || return 0
	[ ! -L "${kaigi_session_dir}" ] && [ ! -L "${kaigi_ready_dir}" ] || return 1
	rm -f "${kaigi_ready_dir}/ready.json" || return 1
	if ! rmdir "${kaigi_ready_dir}"; then
		echo "${name}: could not remove readiness directory: ${kaigi_ready_dir}"
		return 1
	fi
	kaigi_ready_dir=""
}

kaigi_guarded_precmd()
{
	# rc.subr's force prefix can ignore a hook's failure. Exit this instance's
	# subshell instead: startup safety is never a force-overridable warning.
	kaigi_precmd || exit 1
}

kaigi_started()
{
	if "%%LOCALBASE%%/bin/node" "%%WWWDIR%%/app/src/StartupSafety.js" wait "${KAIGI_READY_FILE}" "${pidfile}" "${KAIGI_STARTUP_NONCE}" "${kaigi_start_timeout}"; then
		kaigi_ready_cleanup || return 1
		return 0
	fi
	echo "${name}: startup did not become ready within ${kaigi_start_timeout} seconds"
	kaigi_start_failed=YES
	# Signal only this instance's validated supervisor; it forwards SIGTERM.
	kaigi_supervisor=$(check_pidfile "${kaigi_supervisor_pidfile}" /usr/sbin/daemon)
	[ -z "${kaigi_supervisor}" ] || kill -TERM "${kaigi_supervisor}"
	kaigi_cleanup_wait=0
	while [ "${kaigi_cleanup_wait}" -lt 5 ] && [ -n "$(check_pidfile "${kaigi_supervisor_pidfile}" /usr/sbin/daemon)" ]; do
		sleep 1
		kaigi_cleanup_wait=$((kaigi_cleanup_wait + 1))
	done
	kaigi_supervisor=$(check_pidfile "${kaigi_supervisor_pidfile}" /usr/sbin/daemon)
	if [ -n "${kaigi_supervisor}" ]; then
		kaigi_child=$(check_pidfile "${pidfile}" "%%LOCALBASE%%/bin/node")
		[ -z "${kaigi_child}" ] || kill -KILL "${kaigi_child}"
		kill -KILL "${kaigi_supervisor}"
	fi
	kaigi_ready_cleanup
	kaigi_session_remove
	return 1
}

kaigi_run_instance()
(
	KAIGI_INSTANCE="$1"
	kaigi_run_user="${kaigi_daemon_user}"
	kaigi_run_group="${kaigi_daemon_group}"
	name="kaigi_${KAIGI_INSTANCE}"
	KAIGI_CONFIG_DIR="%%PREFIX%%/etc/kaigi/${KAIGI_INSTANCE}"
	KAIGI_STATE_DIR="/var/db/kaigi/${KAIGI_INSTANCE}"
	kaigi_run_dir="/var/run/kaigi/${KAIGI_INSTANCE}"
	kaigi_session_dir="${kaigi_run_dir}/session"
	kaigi_log_dir="/var/log/kaigi/${KAIGI_INSTANCE}"
	eval "kaigi_run_user=\${kaigi_${KAIGI_INSTANCE}_daemon_user:-\$kaigi_run_user}"
	eval "kaigi_run_group=\${kaigi_${KAIGI_INSTANCE}_daemon_group:-\$kaigi_run_group}"
	export KAIGI_STATE_DIR
	rcvar="kaigi_enable"
	pidfile="${kaigi_run_dir}/kaigi.pid"
	kaigi_supervisor_pidfile="${kaigi_run_dir}/daemon.pid"
	# Validate before rc.subr reads a PID file, including stop/status paths.
	for kaigi_path in /var/run/kaigi "${kaigi_run_dir}" "${pidfile}" "${kaigi_supervisor_pidfile}"; do
		if [ -L "${kaigi_path}" ]; then
			echo "${name}: runtime path must not be a symlink: ${kaigi_path}"
			exit 1
		fi
	done
	procname="%%LOCALBASE%%/bin/node"
	if { [ "${kaigi_shutdown}" = YES ] || [ "${kaigi_operation}" = restart ]; } && [ -f "${pidfile}" ] && [ -f "%%WWWDIR%%/app/src/StartupSafety.js" ]; then
		if ! "%%LOCALBASE%%/bin/node" "%%WWWDIR%%/app/src/StartupSafety.js" identity "${pidfile}"; then
			echo "${name}: stale process identity; refusing to signal it"
			exit 1
		fi
	fi
	command="/usr/sbin/daemon"
	command_args="-f -H -p ${pidfile} -P ${kaigi_supervisor_pidfile} -u ${kaigi_run_user} -o ${kaigi_log_dir}/kaigi.log %%LOCALBASE%%/bin/node app/src/Server.js"
	KAIGI_SOURCE_URL="%%KAIGI_SOURCE_URL%%"
	export KAIGI_INSTANCE KAIGI_CONFIG_DIR KAIGI_SOURCE_URL
	start_precmd="kaigi_guarded_precmd"
	start_postcmd="kaigi_started"
	stop_postcmd="kaigi_session_remove"
	kaigi_start_failed=NO
	if [ "${kaigi_operation}" = restart ]; then
		# Keep readiness failure observable even for force/one restart. rc.subr
		# otherwise performs stop/start in subshells and may override status.
		kaigi_prefix="${kaigi_action%restart}"
		if ! (run_rc_command "${kaigi_prefix}stop"); then
			[ -z "$(check_pidfile "${pidfile}" "${procname}")" ] || exit 1
		fi
		(run_rc_command "${kaigi_prefix}start"; kaigi_status=$?; [ "${kaigi_start_failed}" != YES ] || exit 1; exit "${kaigi_status}")
		exit $?
	fi
	run_rc_command "${kaigi_action}"
	kaigi_status=$?
	[ "${kaigi_start_failed}" != YES ] || exit 1
	exit "${kaigi_status}"
)

# Serialize lifecycle operations. Re-enter under lock with a clean caller
# environment; rc.conf is loaded again inside the lock. No credentials in argv.
case "${kaigi_operation}" in
	start|restart|stop)
		if [ "${kaigi_locked}" != YES ]; then
			kaigi_directory /var/run/kaigi 0755 root wheel || exit 1
			if [ -L /var/run/kaigi/service.lock ]; then
				echo 'kaigi: service lock must not be a symlink'
				exit 1
			fi
			exec /usr/bin/env -i PATH=/sbin:/bin:/usr/sbin:/usr/bin:%%LOCALBASE%%/bin /usr/bin/lockf -k -t 30 /var/run/kaigi/service.lock /bin/sh "$0" --locked "${kaigi_action}" "${2:-}"
		fi
		;;
esac

case "${kaigi_operation}" in
	start|restart)
		if [ ! -r "%%WWWDIR%%/app/src/StartupSafety.js" ]; then
			echo 'kaigi: this service script requires the startup-safety application update'
			exit 1
		fi
		case "${kaigi_start_timeout}" in ''|*[!0-9]*) echo 'kaigi: invalid start timeout'; exit 1 ;; esac
		if [ "${kaigi_start_timeout}" -lt 1 ] || [ "${kaigi_start_timeout}" -gt 300 ]; then
			echo 'kaigi: start timeout must be 1..300 seconds'
			exit 1
		fi
		case "${kaigi_action}" in
			one*|force*) ;;
			*) if ! checkyesno kaigi_enable; then echo 'kaigi: service is disabled'; exit 1; fi ;;
		esac
		kaigi_selected_csv=$(printf '%s\n' "${kaigi_selected}" | tr ' ' ',')
		set -- "%%PREFIX%%/etc/kaigi" /var/db/kaigi /var/run/kaigi "${kaigi_selected_csv}" "${kaigi_operation}"
		for kaigi_instance in ${kaigi_instances}; do
			kaigi_user="${kaigi_daemon_user}"
			kaigi_group="${kaigi_daemon_group}"
			eval "kaigi_user=\${kaigi_${kaigi_instance}_daemon_user:-\$kaigi_user}"
			eval "kaigi_group=\${kaigi_${kaigi_instance}_daemon_group:-\$kaigi_group}"
			set -- "$@" "${kaigi_instance}" "${kaigi_user}" "${kaigi_group}"
		done
		"%%LOCALBASE%%/bin/node" "%%WWWDIR%%/app/src/StartupSafety.js" preflight "$@" || exit 1
		;;
esac

kaigi_result=0
for kaigi_instance in ${kaigi_selected}; do
	if ! kaigi_run_instance "${kaigi_instance}"; then
		kaigi_result=1
		case "${kaigi_operation}" in start|restart) break ;; esac
	fi
done
exit "${kaigi_result}"
